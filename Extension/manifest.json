{
  "name": "gradr",
  "description": "an extension that provides interesting statistics for veracross",
  "version": "1.1",
  "manifest_version": 3,
  "permissions": ["storage", "alarms"],
  "action": {
    "default_popup": "html/index.html"
  },
  "host_permissions": ["https://*.veracross.com/*", "https://*.aurorii.com/*"],
  "background": {
    "service_worker": "js/service-worker.js"
  }
}